# Para desenvolvimento, copie para .env. Na Railway, configure as variáveis no serviço.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Defina um valor aleatório e estável com pelo menos 32 caracteres em produção.
# Gerar com: openssl rand -hex 32
SESSION_SECRET=

# PostgreSQL na Railway. Referencie a variável do serviço de banco.
# Em desenvolvimento, deixe DATABASE_URL vazia para usar o banco local persistente.
DATABASE_URL=
LOCAL_DB_PATH=.local/database

# Nome comercial e dados reais de quem vende.
SELLER_NAME=OrçaMecânica
SELLER_LEGAL_NAME=
SELLER_DOCUMENT=
SELLER_EMAIL=
SELLER_ADDRESS=

# Use ambientes e bancos separados para homologação e produção.
# Na homologação HTTPS, combine sandbox com ALLOW_SANDBOX_CHECKOUT=true.
# Para abrir vendas reais, use production e deixe ALLOW_SANDBOX_CHECKOUT=false.
MP_MODE=sandbox
ALLOW_SANDBOX_CHECKOUT=false
# Apenas para homologação com vendedor e credenciais de teste verificados.
MP_SANDBOX_ALLOW_LIVE_MODE=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=

# Configure um remetente em domínio verificado pelo Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Pixel de produção, usado após consentimento. Necessário para lançar a mídia.
META_PIXEL_ID=
