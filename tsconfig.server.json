{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist-server",
    "noEmit": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts",
    "scripts/check-launch.ts",
    "scripts/reconcile.ts",
    "scripts/metrics.ts"
  ]
}
